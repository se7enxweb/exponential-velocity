# Runtime state — created by the server, never committed
files/
local/
tests/local/
# Mesh identity keypair (private key) — generated on first run, never committed
keys/

# Build artifacts
# sbin/qbixserver.phar and its copy at the former path, bin/qbixserver.phar,
# are NOT here: they are tracked, they are what a Composer install runs, and
# listing them made local rebuilds look like noise instead of the change they
# are. tests/phar-is-current.php checks them against their sources.
qbixserver.phar
!sbin/qbixserver.phar
!bin/qbixserver.phar
node_modules/

# Editor / OS
.DS_Store
*.swp
*~

# Compiled binaries only — native/uwebserver/ holds the C sources of
# sbin/uwebserver, and they are tracked. bin/uwebserver is the forwarder at
# the binary's former path, a tracked script (docs/layout.md, "Programs").
sbin/uwebserver
native/uwebserver/uwebserver-sanitize
native/uwebserver/uwebserver-fuzz
sbin/qbixserver
bin/qbixserver
qbixserver-linux-*
qbixserver-macos-*
qbixserver-windows-*
qbix-build.php
